# systemd-Unit fuer die Einkaufsliste (fherrmann.com/shopping-list).
#
# Installiert deploy/setup-shopping.sh. Von Hand:
#   sudo cp deploy/shopping.service /etc/systemd/system/shopping.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now shopping
#
# Die Token stehen in /etc/shopping.env (siehe EnvironmentFile), lesbar nur
# fuer root und den Dienstnutzer - nirgends im Repo.
#
# Mit dem Rezept-Chat (deploy/setup-recipes.sh) kommt ein Drop-in dazu:
#   /etc/systemd/system/shopping.service.d/10-agent.conf  ->  NoNewPrivileges=false
# Diese Datei bleibt, wie sie ist - das Drop-in nimmt nur die eine Zeile zurueck.

[Unit]
Description=Einkaufsliste (fherrmann.com/shopping-list)
After=network.target

[Service]
User=shopping
Group=shopping
WorkingDirectory=/opt/shopping
EnvironmentFile=/etc/shopping.env
# Absoluter Pfad: das JDK liegt unter /opt/java und ist nicht im PATH eines
# systemd-Dienstes (wie bei todo.service).
ExecStart=/opt/java/jdk-25.0.1+8/bin/java -jar /opt/shopping/app.jar
Restart=on-failure
RestartSec=5

# Der Dienst braucht nichts ausser seinem Datenverzeichnis.
#
# NoNewPrivileges gilt, solange es keinen Rezept-Chat gibt. Der startet seine
# Claude-Session ueber `sudo -u flexii`, und systemd wuerde mit dieser Zeile jede
# Rechteerweiterung im Dienst unterbinden - sudo eingeschlossen. Deshalb setzt
# setup-recipes.sh ein Drop-in mit NoNewPrivileges=false. Die Ausnahme ist eng
# gefasst (deploy/sudoers-recipe-agent): genau ein Kommando, genau ein Zielnutzer,
# feste Aufrufparameter. Wer den Chat nicht braucht, loescht das Drop-in und leert
# SHOPPING_RECIPE_AGENT_COMMAND in /etc/shopping.env.
# KEINE Haertung nachtragen, die NoNewPrivileges von selbst wieder einschaltet -
# laut systemd.exec(5) tun das bei einem Dienst mit User= unter anderem
# SystemCallFilter, RestrictSUIDSGID, ProtectKernel*, PrivateDevices und
# LockPersonality. Verlass ist dann nur auf die Probe des Dienstes beim Start
# (Log: "Rezept-Agent bereit" bzw. "die Probe (--version) endet mit ...") und auf
# "available" in GET /api/chat.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/shopping/data

[Install]
WantedBy=multi-user.target
