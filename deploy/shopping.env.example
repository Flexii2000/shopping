# Umgebung des shopping-Dienstes. Liegt als /etc/shopping.env:
#   sudo chown root:shopping /etc/shopping.env && sudo chmod 640 /etc/shopping.env
#
# deploy/setup-shopping.sh erzeugt die Token beim ersten Lauf selbst
# (openssl rand -hex 24) und laesst eine vorhandene Datei in Ruhe.
#
# Je Person ein Token, mit Namen davor - der Name steht spaeter an den
# Eintraegen ("abgehakt von freundin"). Namen darf man hier aendern; Token
# aendern heisst: Link neu oeffnen bzw. Token in der App neu eingeben.
SHOPPING_TOKENS=felix:changeme-felix,freundin:changeme-freundin
