# Umgebung des shopping-Dienstes. Liegt als /etc/shopping.env:
#   sudo chown root:shopping /etc/shopping.env && sudo chmod 640 /etc/shopping.env
#
# deploy/setup-shopping.sh erzeugt die Token beim ersten Lauf selbst
# (openssl rand -hex 24) und laesst eine vorhandene Datei in Ruhe.
#
# Je Person ein Token, mit Namen davor - der Name steht spaeter an den
# Eintraegen ("abgehakt von joana"). Namen darf man hier aendern; Token
# aendern heisst: Link neu oeffnen bzw. Token in der App neu eingeben.
SHOPPING_TOKENS=felix:changeme-felix,joana:changeme-joana

# --- Rezept-Chat (deploy/setup-recipes.sh traegt das ein) ----------------------
# Das Kommando, mit dem der Dienst die Claude-Session des Chats startet. Leer oder
# fehlend: Rezepte ohne Chat.
#SHOPPING_RECIPE_AGENT_COMMAND=/usr/bin/sudo -n -u flexii /home/flexii/services/recipe-agent/run-agent.sh
# Wer den Chat benutzen darf - Namen aus SHOPPING_TOKENS, * fuer alle. Leer oder
# fehlend: niemand. Jede Antwort zaehlt auf Felix' Claude-Kontingent.
#SHOPPING_RECIPE_CHAT=felix,joana
# Das Modell des Chats (Vorgabe sonnet). Nur ein Modellname oder -alias.
#RECIPE_AGENT_MODEL=sonnet

# --- Kochen: das Rezept als Gericht im Kalorienzaehler --------------------------
#FOOD_URL=http://127.0.0.1:48180
# Derselbe Wert wie FOOD_RECIPE_TOKEN in /etc/food.env - ein eigener Dienst-Token,
# kein persoenlicher. setup-recipes.sh erzeugt ihn und schreibt ihn in beide Dateien.
#SHOPPING_HEALTHY_TOKEN=
